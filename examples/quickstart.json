{
  "name": "Wan Video by Ace Data Cloud quickstart",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "create",
      "name": "Create",
      "type": "@acedatacloud/n8n-nodes-wan-video.wanVideo",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "resource": "video",
        "operation": "create",
        "model": "wan2.6-t2v",
        "prompt": "A red paper kite floating above a green meadow, steady camera, no text. n8n validation.",
        "imageUrl": "",
        "referenceVideoUrls": "",
        "resolution": "720P",
        "duration": 5,
        "audio": false
      },
      "retryOnFail": false
    },
    {
      "id": "wait",
      "name": "Wait 30 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "webhookId": "wan-video-first-video-wait"
    },
    {
      "id": "get",
      "name": "Get Task",
      "type": "@acedatacloud/n8n-nodes-wan-video.wanVideo",
      "typeVersion": 1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "resource": "task",
        "operation": "get",
        "taskId": "={{ $('Create').first().json.taskId }}"
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Create",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create": {
      "main": [
        [
          {
            "node": "Wait 30 Seconds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 30 Seconds": {
      "main": [
        [
          {
            "node": "Get Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
